{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noxia.local/sem-003/blind/blind-runtime-input.schema.json",
  "title": "SEM-003C Blind Runtime Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractType", "caseId", "version", "language", "sourceRequest", "conversationTurns"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "contractType": { "const": "SEM003C_BLIND_RUNTIME_INPUT" },
    "caseId": { "type": "string", "pattern": "^SEM3-BLIND-[A-Z0-9][A-Z0-9-]{2,79}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "language": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$" },
    "sourceRequest": { "type": "string", "minLength": 1 },
    "conversationTurns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["turnId", "role", "text"],
        "properties": {
          "turnId": { "type": "string", "pattern": "^turn-[0-9]+$" },
          "role": { "const": "USER" },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
