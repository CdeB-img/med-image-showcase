{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noxia.local/sem-003/review/human-decision-record.schema.json",
  "title": "SEM-003B3 Human Reference Decision Record",
  "description": "A traceable human reference-review decision. Structural validity never proves that the decision occurred or that it is scientifically correct.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractType",
    "decisionId",
    "caseId",
    "reviewUnitId",
    "reviewType",
    "reviewerRef",
    "reviewerRole",
    "competencies",
    "decision",
    "recommendedDisposition",
    "rationale",
    "scope",
    "createdAt",
    "conflictDeclared",
    "independenceDeclaration",
    "sourceCaseVersion",
    "sourceEnvelopeVersion",
    "reviewItemIds",
    "evidenceReviewed",
    "supersedes",
    "authority",
    "status"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "contractType": { "const": "SEM003B3_HUMAN_REFERENCE_DECISION_RECORD" },
    "decisionId": { "type": "string", "pattern": "^SEM3B3-HDR-[A-Z0-9][A-Z0-9-]{2,127}$" },
    "caseId": { "type": "string", "pattern": "^SEM3-(DEV|CAL)-[A-Z0-9][A-Z0-9-]{2,127}$" },
    "reviewUnitId": { "type": "string", "pattern": "^SEM3B3-RU-[A-Z0-9][A-Z0-9-]{2,127}$" },
    "reviewType": {
      "enum": [
        "SCIENTIFIC_REFERENCE",
        "METHODOLOGICAL_REFERENCE",
        "AMBIGUITY",
        "PARENTAGE",
        "CALIBRATION_ADMISSION",
        "SEMANTIC_EQUIVALENCE"
      ]
    },
    "reviewerRef": {
      "type": "string",
      "pattern": "^REVIEWER-[A-Z0-9][A-Z0-9-]{1,63}$",
      "description": "Stable reviewer reference; a personal name is not required."
    },
    "reviewerRole": { "type": "string", "minLength": 1 },
    "competencies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "decision": {
      "enum": [
        "ACCEPT",
        "ACCEPT_WITH_REVISION",
        "REJECT",
        "NEEDS_SPECIALIST_REVIEW",
        "NOT_REQUIRED",
        "AMBIGUITY_CONFIRMED",
        "AMBIGUITY_REVISED",
        "NOT_ACTUALLY_AMBIGUOUS",
        "SPECIALIST_REVIEW_REQUIRED",
        "PARENTAGE_CLEAR",
        "RELATED_VISIBLE_CASE",
        "CONTAMINATED_FOR_CALIBRATION",
        "PARENTAGE_REVIEW_UNRESOLVED",
        "APPROVE",
        "DO_NOT_APPROVE",
        "DEFER",
        "SEMANTICALLY_EQUIVALENT",
        "NONCRITICAL_VARIATION",
        "NOT_EQUIVALENT",
        "NOT_ADJUDICABLE"
      ]
    },
    "recommendedDisposition": {
      "description": "Required for CALIBRATION_ADMISSION; null for all other review types.",
      "anyOf": [
        { "type": "null" },
        {
          "enum": [
            "CALIBRATION_VISIBLE",
            "REJECTED",
            "NEEDS_SPECIALIST_REVIEW"
          ]
        }
      ]
    },
    "rationale": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "conflictDeclared": {
      "enum": [
        "NO_CONFLICT_DECLARED",
        "CONFLICT_DECLARED_AND_MANAGED",
        "CONFLICT_REQUIRES_SECOND_REVIEW",
        "NOT_RECORDED"
      ]
    },
    "independenceDeclaration": {
      "enum": [
        "INDEPENDENT_FOR_STATED_SCOPE",
        "NOT_INDEPENDENT",
        "NOT_RECORDED"
      ]
    },
    "sourceCaseVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "sourceEnvelopeVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "reviewItemIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^SEM3B1-REVIEW-[0-9]{3}$" }
    },
    "evidenceReviewed": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "supersedes": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^SEM3B3-HDR-[A-Z0-9][A-Z0-9-]{2,127}$" }
      ]
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resultingCaseVersion", "resultingEnvelopeVersion", "changes", "reason"],
      "properties": {
        "resultingCaseVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "resultingEnvelopeVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "reason": { "type": "string", "minLength": 1 },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "jsonPointer", "replacementValue"],
            "properties": {
              "target": { "enum": ["CASE", "ACCEPTANCE_ENVELOPE"] },
              "jsonPointer": { "type": "string", "pattern": "^/" },
              "replacementValue": {}
            }
          }
        }
      }
    },
    "authority": { "const": "HUMAN_REFERENCE_REVIEW" },
    "status": { "const": "FINAL" }
  }
}
