{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noxia.local/sem-003/evaluator/evaluation-result.schema.json",
  "title": "SEM-003 Scientific Understanding Evaluation Result",
  "description": "Explainable benchmark evaluation result. It contains no aggregate score and cannot pronounce a PD-011 campaign decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractType",
    "evaluationId",
    "evaluatorIdentity",
    "mode",
    "caseId",
    "candidateId",
    "disposition",
    "level1",
    "level2",
    "propertyJudgments",
    "criticalViolations",
    "findings",
    "firstCause",
    "equivalence",
    "clarification",
    "enrichment",
    "ownership",
    "provenance",
    "evidenceTrace"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "contractType": { "const": "BENCHMARK_EVALUATION_RESULT" },
    "evaluationId": { "type": "string", "pattern": "^SEM3-EVAL-[A-Z0-9][A-Z0-9-]{2,127}$" },
    "evaluatorIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "configurationDigest"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "configurationDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "mode": { "enum": ["DEVELOPMENT_SYNTHETIC", "FUTURE_SEM_RUNTIME", "HUMAN_ADJUDICATION"] },
    "caseId": { "type": "string" },
    "candidateId": { "type": "string" },
    "disposition": {
      "enum": [
        "ACCEPTABLE_SEMANTIC_EQUIVALENT",
        "ACCEPTABLE_NONCRITICAL_VARIATION",
        "SAFE_FAIL_CLOSED",
        "SEMANTIC_FAILURE",
        "PROVIDER_EXECUTION_FAILURE",
        "NOT_EVALUABLE"
      ]
    },
    "level1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checkCount", "criticalVector"],
      "properties": {
        "status": { "enum": ["PASS", "FAIL", "NOT_EVALUABLE"] },
        "checkCount": { "type": "integer", "minimum": 0 },
        "criticalVector": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["propertyId", "judgment"],
            "properties": {
              "propertyId": { "type": "string" },
              "judgment": { "enum": ["SATISFIED", "VIOLATED", "NOT_APPLICABLE", "NOT_EVALUABLE", "ADJUDICATION_REQUIRED"] }
            }
          }
        }
      }
    },
    "level2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "adjudicationPackets"],
      "properties": {
        "status": { "enum": ["ADJUDICATION_NOT_REQUIRED", "ADJUDICATION_REQUIRED", "HUMAN_DECISION_APPLIED", "NOT_EVALUABLE"] },
        "adjudicationPackets": { "type": "array", "items": { "$ref": "adjudication-packet.schema.json" } }
      }
    },
    "propertyJudgments": { "type": "array", "minItems": 1, "items": { "$ref": "property-judgment.schema.json" } },
    "criticalViolations": { "type": "array", "items": { "$ref": "#/definitions/finding" } },
    "findings": { "type": "array", "items": { "$ref": "#/definitions/finding" } },
    "firstCause": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/definitions/finding" }
      ]
    },
    "equivalence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "structureProfile", "referenceVariantId", "requiresHumanDecision"],
      "properties": {
        "classification": { "enum": ["DECLARED_EQUIVALENT", "NONCRITICAL_FORM_VARIATION", "REQUIRES_ADJUDICATION", "NOT_EQUIVALENT", "NOT_ASSESSED"] },
        "structureProfile": { "type": "string" },
        "referenceVariantId": { "oneOf": [{ "type": "null" }, { "type": "string" }] },
        "requiresHumanDecision": { "type": "boolean" }
      }
    },
    "clarification": { "$ref": "#/definitions/domainSummary" },
    "enrichment": { "$ref": "#/definitions/domainSummary" },
    "ownership": { "$ref": "#/definitions/domainSummary" },
    "provenance": { "$ref": "#/definitions/domainSummary" },
    "evidenceTrace": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  },
  "definitions": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findingId", "stage", "code", "failureClass", "propertyIds", "referenceId", "message", "isFirstCause", "downstreamOf"],
      "properties": {
        "findingId": { "type": "string", "pattern": "^finding-[a-z0-9-]+$" },
        "stage": { "enum": ["CONTRACT", "LEVEL_1", "LEVEL_2", "EXECUTION"] },
        "code": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "failureClass": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "propertyIds": { "type": "array", "items": { "type": "string", "pattern": "^PROPERTY_[A-Z0-9_]+$" }, "uniqueItems": true },
        "referenceId": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "isFirstCause": { "type": "boolean" },
        "downstreamOf": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^finding-[a-z0-9-]+$" }] }
      }
    },
    "domainSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidenceRefs", "adjudicationRequired"],
      "properties": {
        "status": { "enum": ["PRESERVED", "VIOLATED", "NOT_APPLICABLE", "NOT_EVALUABLE", "ADJUDICATION_REQUIRED"] },
        "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "adjudicationRequired": { "type": "boolean" }
      }
    }
  }
}
