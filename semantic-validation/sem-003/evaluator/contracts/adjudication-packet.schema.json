{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noxia.local/sem-003/evaluator/adjudication-packet.schema.json",
  "title": "SEM-003 Governed Adjudication Packet",
  "description": "Open benchmark review packet. It requests a governed judgment and never constitutes that judgment or its authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractType",
    "packetId",
    "caseId",
    "candidateId",
    "propertyIds",
    "reason",
    "sourceRequestRef",
    "obligationRefs",
    "candidateEvidenceRefs",
    "decisionRequested",
    "permittedDecisions",
    "potentialFailureClasses",
    "status"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "contractType": { "const": "BENCHMARK_EVALUATION_ADJUDICATION_PACKET" },
    "packetId": { "type": "string", "pattern": "^SEM3-ADJ-[A-Z0-9][A-Z0-9-]{2,127}$" },
    "caseId": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{2,127}$" },
    "candidateId": { "type": "string", "pattern": "^SEM3-EVAL-CAND-[A-Z0-9][A-Z0-9-]{2,95}$" },
    "propertyIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^PROPERTY_[A-Z0-9_]+$" }, "uniqueItems": true },
    "reason": { "type": "string", "minLength": 1 },
    "sourceRequestRef": { "type": "string", "minLength": 1 },
    "obligationRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "candidateEvidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "decisionRequested": { "type": "string", "minLength": 1 },
    "permittedDecisions": {
      "type": "array",
      "minItems": 2,
      "items": { "enum": ["SATISFIED", "VIOLATED", "EQUIVALENT", "ACCEPTABLE_WITH_RESERVE", "NON_EQUIVALENT", "NOT_ADJUDICABLE"] },
      "uniqueItems": true
    },
    "potentialFailureClasses": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" }, "uniqueItems": true },
    "status": { "enum": ["OPEN", "RESOLVED"] },
    "humanDecisionRecordId": {
      "type": "string",
      "pattern": "^SEM3-HDR-[A-Z0-9][A-Z0-9-]{2,127}$"
    },
    "decisionRecordId": {
      "type": "string",
      "pattern": "^SEM3-(ADR|HDR)-[A-Z0-9][A-Z0-9-]{2,127}$"
    }
  }
}
