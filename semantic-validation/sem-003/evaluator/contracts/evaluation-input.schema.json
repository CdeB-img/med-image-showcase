{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noxia.local/sem-003/evaluator/evaluation-input.schema.json",
  "title": "SEM-003 Scientific Understanding Evaluation Input",
  "description": "Benchmark evaluation input binding an authored Case, its Acceptance Envelope, and a normalized candidate output. It is not a product runtime contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractType",
    "evaluationId",
    "evaluationMode",
    "benchmarkCase",
    "acceptanceEnvelope",
    "candidateOutput"
  ],
  "properties": {
    "schemaVersion": { "enum": ["1.0.0", "1.1.0", "1.2.0", "1.3.0"] },
    "contractType": { "const": "BENCHMARK_EVALUATION_INPUT" },
    "evaluationId": { "type": "string", "pattern": "^SEM3-EVAL-[A-Z0-9][A-Z0-9-]{2,127}$" },
    "evaluationMode": { "enum": ["DEVELOPMENT_SYNTHETIC", "CALIBRATION_SYNTHETIC", "FUTURE_SEM_RUNTIME", "HUMAN_ADJUDICATION"] },
    "benchmarkSet": { "enum": ["DEVELOPMENT", "CALIBRATION", "BLIND"] },
    "benchmarkCase": {
      "oneOf": [
        { "$ref": "#/definitions/visibleAuthoringCase" },
        { "$ref": "#/definitions/sealedBlindReferenceCase" }
      ]
    },
    "acceptanceEnvelope": {
      "oneOf": [
        { "$ref": "#/definitions/visibleAuthoringEnvelope" },
        { "$ref": "#/definitions/sealedBlindReferenceEnvelope" }
      ]
    },
    "candidateOutput": { "$ref": "candidate-semantic-representation.schema.json" },
    "humanDecisionRecords": {
      "type": "array",
      "items": { "$ref": "human-decision-record.schema.json" }
    },
    "adjudicationDecisionRecords": {
      "type": "array",
      "items": { "$ref": "adjudication-decision-record.schema.json" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": "1.3.0" } } },
      "then": { "required": ["benchmarkSet"] }
    },
    {
      "if": { "properties": { "evaluationMode": { "const": "FUTURE_SEM_RUNTIME" } } },
      "then": {
        "required": ["benchmarkSet"],
        "properties": {
          "schemaVersion": { "const": "1.3.0" },
          "benchmarkSet": { "const": "BLIND" },
          "benchmarkCase": { "$ref": "#/definitions/sealedBlindReferenceCase" },
          "acceptanceEnvelope": { "$ref": "#/definitions/sealedBlindReferenceEnvelope" }
        }
      }
    },
    {
      "if": { "properties": { "evaluationMode": { "const": "HUMAN_ADJUDICATION" } } },
      "then": {
        "anyOf": [
          { "required": ["humanDecisionRecords"] },
          { "required": ["adjudicationDecisionRecords"] }
        ]
      }
    },
    {
      "not": { "required": ["humanDecisionRecords", "adjudicationDecisionRecords"] }
    }
  ],
  "definitions": {
    "visibleAuthoringCase": {
      "type": "object",
      "required": ["contractType", "caseId", "version", "source", "reference"],
      "properties": {
        "contractType": { "const": "BENCHMARK_AUTHORING_CASE" },
        "caseId": { "type": "string" },
        "version": { "type": "string" },
        "source": { "type": "object" },
        "reference": { "type": "object" }
      }
    },
    "visibleAuthoringEnvelope": {
      "type": "object",
      "required": ["contractType", "envelopeId", "caseId", "version", "required", "prohibited", "properties"],
      "properties": {
        "contractType": { "const": "BENCHMARK_AUTHORING_ACCEPTANCE_ENVELOPE" },
        "envelopeId": { "type": "string" },
        "caseId": { "type": "string" },
        "version": { "type": "string" },
        "required": { "type": "array" },
        "prohibited": { "type": "array" },
        "properties": { "type": "array" }
      }
    },
    "sealedBlindReferenceCase": {
      "type": "object",
      "required": ["contractType", "purpose", "caseId", "version", "source", "scientificScope", "exposure", "reference"],
      "properties": {
        "contractType": { "const": "SEM003C_BLIND_BENCHMARK_CASE" },
        "purpose": { "const": "BLIND_QUALIFICATION_AUTHORING" },
        "caseId": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{2,127}$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "source": { "type": "object" },
        "scientificScope": { "type": "object" },
        "exposure": {
          "type": "object",
          "required": ["exposureStatus", "eligibleForBlindQualification"],
          "properties": {
            "exposureStatus": { "const": "BLIND_SEALED" },
            "eligibleForBlindQualification": { "const": true }
          }
        },
        "reference": {
          "type": "object",
          "required": ["acceptanceEnvelopeId"],
          "properties": {
            "acceptanceEnvelopeId": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{2,127}$" }
          }
        }
      }
    },
    "sealedBlindReferenceEnvelope": {
      "type": "object",
      "required": ["contractType", "envelopeId", "caseId", "version", "required", "prohibited", "acceptableSemanticVariants", "optionalRelevant", "admissibleAmbiguities", "expectedClarification", "ownershipBoundaries", "properties", "adjudication", "evaluationDemonstrations"],
      "properties": {
        "contractType": { "const": "SEM003C_BLIND_ACCEPTANCE_ENVELOPE" },
        "envelopeId": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{2,127}$" },
        "caseId": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{2,127}$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "required": { "type": "array" },
        "prohibited": { "type": "array" },
        "acceptableSemanticVariants": { "type": "array" },
        "optionalRelevant": { "type": "array" },
        "admissibleAmbiguities": { "type": "array" },
        "expectedClarification": { "type": "object" },
        "ownershipBoundaries": { "type": "array" },
        "properties": { "type": "array" },
        "adjudication": { "type": "object" },
        "evaluationDemonstrations": { "type": "array" }
      }
    }
  }
}
