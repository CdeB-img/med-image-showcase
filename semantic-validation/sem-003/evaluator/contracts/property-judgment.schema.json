{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noxia.local/sem-003/evaluator/property-judgment.schema.json",
  "title": "SEM-003 Property Judgment",
  "description": "Benchmark evaluation judgment. It does not alter SEM-002, PD-003, OBS, or any scientific source of truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "propertyId",
    "alias",
    "family",
    "evaluationScope",
    "checkType",
    "judgment",
    "applicable",
    "compensable",
    "failureClass",
    "firstCause",
    "evidenceTrace",
    "downstreamFindings",
    "adjudicationPacketId"
  ],
  "properties": {
    "propertyId": { "type": "string", "pattern": "^PROPERTY_[A-Z0-9_]+$" },
    "alias": { "type": "string", "pattern": "^P(0[1-9]|1[0-8])$" },
    "family": {
      "enum": ["SAFETY_FIDELITY_INVARIANT", "SCIENTIFIC_UNDERSTANDING_COMPETENCE", "CONTEXTUAL_ENRICHMENT"]
    },
    "evaluationScope": { "enum": ["ABSOLUTE_RUN_LEVEL", "STATISTICAL_PROPERTY_MECHANIC_ONLY"] },
    "checkType": { "enum": ["DETERMINISTIC_CHECK", "REFERENCE_DECLARED_CHECK", "ADJUDICATION_CHECK"] },
    "judgment": { "enum": ["SATISFIED", "VIOLATED", "NOT_APPLICABLE", "NOT_EVALUABLE", "ADJUDICATION_REQUIRED"] },
    "applicable": { "type": "boolean" },
    "compensable": { "const": false },
    "failureClass": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
    "firstCause": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "stage", "referenceId", "message"],
          "properties": {
            "code": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
            "stage": { "enum": ["CONTRACT", "LEVEL_1", "LEVEL_2", "EXECUTION"] },
            "referenceId": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "evidenceTrace": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "downstreamFindings": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "adjudicationPacketId": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^SEM3-ADJ-[A-Z0-9][A-Z0-9-]{2,127}$" }
      ]
    }
  }
}
