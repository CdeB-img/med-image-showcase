        },
        "turnId": {
          "title": "Turnid",
          "type": "string"
        }
      },
      "required": [
        "turnId",
        "sourceText"
      ],
      "title": "SourceEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
