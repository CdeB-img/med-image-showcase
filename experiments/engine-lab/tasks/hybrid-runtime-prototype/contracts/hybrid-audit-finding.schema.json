      "type": "string"
    },
    "candidatePointer": {
      "title": "Candidatepointer",
      "type": "string"
    },
    "confidence": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "confirmsFindingIds": {
      "items": {
        "type": "string"
      },
      "title": "Confirmsfindingids",
      "type": "array"
    },
    "findingClass": {
      "title": "Findingclass",
      "type": "string"
    },
    "findingId": {
      "title": "Findingid",
      "type": "string"
    },
    "origin": {
      "enum": [
        "SEM_AUDIT_D",
        "SEM_AUDIT_L"
      ],
      "title": "Origin",
      "type": "string"
    },
    "rationale": {
      "title": "Rationale",
      "type": "string"
    },
    "resolutionOwner": {
      "title": "Resolutionowner",
      "type": "string"
    },
    "severity": {
      "enum": [
        "INFO",
        "MINOR",
        "MAJOR",
        "CRITICAL"
