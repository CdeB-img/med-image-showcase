      "type": "string"
    },
    "sourceEvidence": {
      "items": {
        "$ref": "#/$defs/SourceEvidence"
      },
      "title": "Sourceevidence",
      "type": "array"
    },
    "status": {
      "enum": [
        "OPEN",
        "ACKNOWLEDGED",
        "REJECTED",
        "RESOLVED"
