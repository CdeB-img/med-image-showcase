          "title": "Polarity",
          "type": "string"
        },
        "provenanceTurnIds": {
          "items": {
            "type": "string"
          },
          "title": "Provenanceturnids",
          "type": "array"
        },
        "scientificRole": {
          "title": "Scientificrole",
          "type": "string"
        },
        "sourceText": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sourcetext"
        },
        "temporalContext": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
