  "additionalProperties": false,
  "properties": {
    "correctedState": {
      "$ref": "#/$defs/CommonScientificState"
    },
    "rationale": {
      "title": "Rationale",
      "type": "string"
    },
    "verdict": {
      "enum": [
        "ACCEPT",
        "REVISE"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "required": [
    "verdict",
    "rationale",
    "correctedState"
  ],
  "title": "CriticResult",
  "type": "object"
}
