        "sourceText": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sourcetext"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "temporalContext": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temporalcontext"
        }
