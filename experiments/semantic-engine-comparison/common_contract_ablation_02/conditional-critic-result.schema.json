          "title": "Blocking",
          "type": "boolean"
        },
        "clarificationId": {
          "title": "Clarificationid",
          "type": "string"
        },
        "decisionImpact": {
          "title": "Decisionimpact",
          "type": "string"
        },
        "priority": {
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW",
            "UNKNOWN"
