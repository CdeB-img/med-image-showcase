          "title": "Epistemicstatus",
          "type": "string"
        },
        "itemId": {
          "title": "Itemid",
          "type": "string"
        },
        "ownership": {
          "title": "Ownership",
          "type": "string"
        },
        "polarity": {
          "enum": [
            "AFFIRMED",
            "NEGATED",
            "UNCERTAIN",
            "CONDITIONAL"
