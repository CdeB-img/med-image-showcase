        "epistemicStatus": {
          "enum": [
            "EXPLICIT_USER_STATED",
            "INFERRED_HIGH_CONFIDENCE",
            "INFERRED_CANDIDATE",
            "SUPPORTED_CANDIDATE",
            "UNSUPPORTED_CANDIDATE",
            "CONFIRMED_BY_USER",
            "REJECTED_BY_USER",
            "UNKNOWN",
            "AMBIGUOUS"
