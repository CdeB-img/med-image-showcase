{
  "$defs": {
    "NativeClarification": {
      "additionalProperties": false,
      "properties": {
        "clarificationId": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,95}$",
          "title": "Clarificationid",
          "type": "string"
        },
        "question": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "resolvesSemanticKeys": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Resolvessemantickeys",
          "type": "array"
        }
      },
      "required": [
        "clarificationId",
        "question",
        "reason"
      ],
      "title": "NativeClarification",
      "type": "object"
    },
    "NativeOpenIssue": {
      "additionalProperties": false,
      "properties": {
        "issueId": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,95}$",
          "title": "Issueid",
          "type": "string"
        },
        "semanticKey": {
          "pattern": "^[a-z0-9][a-z0-9.-]{1,95}$",
          "title": "Semantickey",
          "type": "string"
        },
        "description": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "sourceEvidence": {
          "items": {
            "$ref": "#/$defs/SourceEvidence"
          },
          "maxItems": 20,
          "title": "Sourceevidence",
          "type": "array"
        }
      },
      "required": [
        "issueId",
        "semanticKey",
        "description"
      ],
      "title": "NativeOpenIssue",
      "type": "object"
    },
    "NormalizedSemanticElement": {
      "additionalProperties": false,
      "properties": {
        "elementId": {
          "title": "Elementid",
          "type": "string"
        },
        "semanticKey": {
          "title": "Semantickey",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "elementType": {
          "title": "Elementtype",
          "type": "string"
        },
        "studyRole": {
          "title": "Studyrole",
          "type": "string"
        },
        "polarity": {
          "enum": [
            "AFFIRMED",
            "NEGATED",
            "UNCERTAIN",
            "CONDITIONAL"
          ],
          "title": "Polarity",
          "type": "string"
        },
        "epistemicStatus": {
          "enum": [
            "EXPLICIT_USER_STATED",
            "INFERRED_HIGH_CONFIDENCE",
            "INFERRED_CANDIDATE",
            "SUPPORTED_CANDIDATE",
            "UNSUPPORTED_CANDIDATE",
            "CONFIRMED_BY_USER",
            "REJECTED_BY_USER",
            "UNKNOWN",
            "AMBIGUOUS"
          ],
          "title": "Epistemicstatus",
          "type": "string"
        },
        "adoptionStatus": {
          "enum": [
            "NOT_ADOPTED",
            "CANDIDATE",
            "ADOPTED_BY_HUMAN",
            "REJECTED",
            "NOT_APPLICABLE"
          ],
          "title": "Adoptionstatus",
          "type": "string"
        },
        "sourceEvidence": {
          "items": {
            "$ref": "#/$defs/SourceEvidence"
          },
          "title": "Sourceevidence",
          "type": "array"
        },
        "inferenceReason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Inferencereason"
        },
        "requiresConfirmation": {
          "title": "Requiresconfirmation",
          "type": "boolean"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "sourceNativeId": {
          "title": "Sourcenativeid",
          "type": "string"
        },
        "supersedesSourceNativeIds": {
          "items": {
            "type": "string"
          },
          "title": "Supersedessourcenativeids",
          "type": "array"
        },
        "category": {
          "enum": [
            "CONTENT",
            "OPTIONAL_CANDIDATE"
          ],
          "title": "Category",
          "type": "string"
        }
      },
      "required": [
        "elementId",
        "semanticKey",
        "label",
        "elementType",
        "studyRole",
        "polarity",
        "epistemicStatus",
        "adoptionStatus",
        "sourceEvidence",
        "inferenceReason",
        "requiresConfirmation",
        "confidence",
        "sourceNativeId",
        "supersedesSourceNativeIds",
        "category"
      ],
      "title": "NormalizedSemanticElement",
      "type": "object"
    },
    "NormalizedSemanticRelation": {
      "additionalProperties": false,
      "properties": {
        "relationId": {
          "title": "Relationid",
          "type": "string"
        },
        "semanticKey": {
          "title": "Semantickey",
          "type": "string"
        },
        "sourceElementId": {
          "title": "Sourceelementid",
          "type": "string"
        },
        "targetElementId": {
          "title": "Targetelementid",
          "type": "string"
        },
        "predicate": {
          "title": "Predicate",
          "type": "string"
        },
        "polarity": {
          "enum": [
            "AFFIRMED",
            "NEGATED",
            "UNCERTAIN",
            "CONDITIONAL"
          ],
          "title": "Polarity",
          "type": "string"
        },
        "epistemicStatus": {
          "enum": [
            "EXPLICIT_USER_STATED",
            "INFERRED_HIGH_CONFIDENCE",
            "INFERRED_CANDIDATE",
            "SUPPORTED_CANDIDATE",
            "UNSUPPORTED_CANDIDATE",
            "CONFIRMED_BY_USER",
            "REJECTED_BY_USER",
            "UNKNOWN",
            "AMBIGUOUS"
          ],
          "title": "Epistemicstatus",
          "type": "string"
        },
        "adoptionStatus": {
          "enum": [
            "NOT_ADOPTED",
            "CANDIDATE",
            "ADOPTED_BY_HUMAN",
            "REJECTED",
            "NOT_APPLICABLE"
          ],
          "title": "Adoptionstatus",
          "type": "string"
        },
        "sourceEvidence": {
          "items": {
            "$ref": "#/$defs/SourceEvidence"
          },
          "title": "Sourceevidence",
          "type": "array"
        },
        "inferenceReason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Inferencereason"
        },
        "requiresConfirmation": {
          "title": "Requiresconfirmation",
          "type": "boolean"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "sourceNativeId": {
          "title": "Sourcenativeid",
          "type": "string"
        },
        "category": {
          "enum": [
            "RELATION",
            "CORRECTION"
          ],
          "title": "Category",
          "type": "string"
        }
      },
      "required": [
        "relationId",
        "semanticKey",
        "sourceElementId",
        "targetElementId",
        "predicate",
        "polarity",
        "epistemicStatus",
        "adoptionStatus",
        "sourceEvidence",
        "inferenceReason",
        "requiresConfirmation",
        "confidence",
        "sourceNativeId",
        "category"
      ],
      "title": "NormalizedSemanticRelation",
      "type": "object"
    },
    "SourceEvidence": {
      "additionalProperties": false,
      "properties": {
        "messageId": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Messageid",
          "type": "string"
        },
        "quote": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "messageId",
        "quote"
      ],
      "title": "SourceEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "contractType": {
      "const": "NORMALIZED_CANDIDATE_SEMANTIC_REPRESENTATION",
      "default": "NORMALIZED_CANDIDATE_SEMANTIC_REPRESENTATION",
      "title": "Contracttype",
      "type": "string"
    },
    "baselineId": {
      "title": "Baselineid",
      "type": "string"
    },
    "runId": {
      "title": "Runid",
      "type": "string"
    },
    "caseId": {
      "title": "Caseid",
      "type": "string"
    },
    "caseVersion": {
      "title": "Caseversion",
      "type": "string"
    },
    "language": {
      "enum": [
        "fr",
        "en"
      ],
      "title": "Language",
      "type": "string"
    },
    "executionStatus": {
      "enum": [
        "COMPLETED",
        "SAFE_FAIL_CLOSED",
        "PROVIDER_FAILURE",
        "NOT_EVALUABLE"
      ],
      "title": "Executionstatus",
      "type": "string"
    },
    "normalizedMeaning": {
      "title": "Normalizedmeaning",
      "type": "string"
    },
    "semanticElements": {
      "items": {
        "$ref": "#/$defs/NormalizedSemanticElement"
      },
      "title": "Semanticelements",
      "type": "array"
    },
    "semanticRelations": {
      "items": {
        "$ref": "#/$defs/NormalizedSemanticRelation"
      },
      "title": "Semanticrelations",
      "type": "array"
    },
    "unknowns": {
      "items": {
        "$ref": "#/$defs/NativeOpenIssue"
      },
      "title": "Unknowns",
      "type": "array"
    },
    "ambiguities": {
      "items": {
        "$ref": "#/$defs/NativeOpenIssue"
      },
      "title": "Ambiguities",
      "type": "array"
    },
    "clarifications": {
      "items": {
        "$ref": "#/$defs/NativeClarification"
      },
      "title": "Clarifications",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "nativeOutputDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Nativeoutputdigest",
      "type": "string"
    },
    "normalizationPolicy": {
      "const": "LOSSLESS_REFERENCE_BLIND_1.0.0",
      "default": "LOSSLESS_REFERENCE_BLIND_1.0.0",
      "title": "Normalizationpolicy",
      "type": "string"
    }
  },
  "required": [
    "baselineId",
    "runId",
    "caseId",
    "caseVersion",
    "language",
    "executionStatus",
    "normalizedMeaning",
    "semanticElements",
    "semanticRelations",
    "unknowns",
    "ambiguities",
    "clarifications",
    "warnings",
    "nativeOutputDigest"
  ],
  "title": "NormalizedCandidateSemanticRepresentation",
  "type": "object"
}
